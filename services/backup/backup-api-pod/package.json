    "@hanzoteam/server-backup": "workspace:^0.7.0",
    "@hanzoteam/core": "workspace:^0.7.24",
    "@hanzoteam/platform": "workspace:^0.7.19",
    "@hanzoteam/account-client": "workspace:^0.7.21",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "postgres": "^3.4.7",
    "sharp": "~0.34.3",
    "morgan": "^1.10.0"
  }
