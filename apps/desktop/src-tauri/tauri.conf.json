{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanzo Team",
  "version": "1.1.1",
  "identifier": "ai.hanzo.team",
  "mainBinaryName": "hanzo-team",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../.. build",
    "devUrl": "http://localhost:3095",
    "frontendDist": "../../../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "deb", "dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": []
  }
}
