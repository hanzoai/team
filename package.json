{
  "name": "@hanzo/team",
  "version": "1.1.4",
  "type": "module",
  "description": "Hanzo Team — the tracker and the workspace, on @hanzo/gui + @hanzo/ui.",
  "license": "Apache-2.0 OR MIT",
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoai/team.git"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "predev": "node --experimental-strip-types scripts/assets.ts",
    "dev": "vite",
    "prebuild": "node --experimental-strip-types scripts/assets.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "test:bundle": "node --test scripts/check-bundle-no-mocks.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hanzo/ai": "0.7.0",
    "@hanzo/app": "0.3.140",
    "@hanzo/appearance": "0.2.15",
    "@hanzo/build": "0.2.141",
    "@hanzo/composer": "0.2.1",
    "@hanzo/crm": "0.1.0",
    "@hanzo/data": "1.4.8",
    "@hanzo/event": "0.3.73",
    "@hanzo/font": "1.9.3",
    "@hanzo/gui": "8.3.5",
    "@hanzo/i18n": "0.6.1",
    "@hanzo/iam": "0.21.42",
    "@hanzo/ui": "8.33.6",
    "@hanzo/usage": "0.2.0",
    "@hanzo/voice": "0.1.19",
    "@hanzogui/lucide-icons-2": "8.3.5",
    "@hanzogui/next-theme": "8.3.5",
    "livekit-client": "^2.25.0",
    "lucide-react": "1.42.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native-web": "^0.21.2",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@hanzo/vite": "0.1.4",
    "@playwright/test": "^1.65.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  }
}
