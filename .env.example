# ---- Hanzo IAM (the only auth path) ----
# Canonical env contract per docs.hanzo.ai/services/iam/configuration.
# Federation (Google/GitHub/SAML/OIDC) lives INSIDE IAM — team-go is
# just an OAuth client. Create the IAM app via the IAM admin UI and
# paste the credentials here (or in KMS for prod).
IAM_ENDPOINT=https://hanzo.id
IAM_CLIENT_ID=hanzo-team
IAM_CLIENT_SECRET=<set in KMS for prod>
IAM_ORG=hanzo
IAM_APP=hanzo-team

# ---- Hanzo KMS (optional, for secrets at rest) ----
KMS_ENDPOINT=https://kms.hanzo.ai

# ---- Commerce (single source of truth for billing) ----
# In cluster: http://commerce.hanzo.svc:8001
COMMERCE_ENDPOINT=https://commerce.hanzo.ai

# ---- hanzo.bot (in-app AI agent) ----
BOT_ENDPOINT=https://hanzo.bot

# ---- LLM Gateway (for /v1/ai/* inline completions) ----
LLM_GATEWAY_URL=https://api.hanzo.ai/v1
HANZO_API_KEY=<set for prod / leave blank for dev>

# ---- SMTP (notify.fn.ts email channel; optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hanzo.team

# ---- Telegram (notify.fn.ts telegram channel; optional) ----
TELEGRAM_BOT_TOKEN=

# ---- Hooks/migrations runtime config ----
TEAM_HOOKS_DIR=./functions/dist
TEAM_MIGRATIONS_DIR=./migrations
TEAM_HOOKS_WATCH=true
